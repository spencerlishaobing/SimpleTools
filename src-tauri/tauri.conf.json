{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleTools",
  "version": "0.58.3",
  "identifier": "com.simpletools.desktop",
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-tvbox-all.ps1",
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-tvbox-all.ps1",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SimpleTools - 常用工具",
        "width": 1200,
        "height": 780,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "resources": ["resources/mpv/libmpv-2.dll", "resources/mpv/provenance.json", "resources/mpv/COPYING.txt", "resources/mpv/Copyright.txt", "resources/aria2/aria2c.exe", "resources/aria2/COPYING", "resources/aria2/LICENSE.OpenSSL", "resources/aria2/provenance.json", "resources/python/", "resources/tvpython/", "resources/java/jre/", "resources/java/lib/", "resources/java/dex-runtime/", "resources/java/host.jar", "resources/java/jre-provenance.json", "resources/java/dependencies.json"],
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerHooks": "nsis/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
